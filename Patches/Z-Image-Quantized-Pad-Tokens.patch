+  public func loadPadTokens(
+    from weights: [String: MLXArray], groupSize: Int = 32, bits: Int = 8,
+    mode: QuantizationMode = .affine
+  ) {
+    setPadTokens(
+      xPad: decodedPadToken(
+        "x_pad_token", weights: weights, groupSize: groupSize, bits: bits, mode: mode
+      ),
+      capPad: decodedPadToken(
+        "cap_pad_token", weights: weights, groupSize: groupSize, bits: bits, mode: mode
+      )
+    )
+  }
+
+  private func decodedPadToken(
+    _ key: String,
+    weights: [String: MLXArray],
+    groupSize: Int,
+    bits: Int,
+    mode: QuantizationMode
+  ) -> MLXArray? {
+    guard let packed = weights[key] else { return nil }
+    let token: MLXArray
+    if let scales = weights["\(key).scales"] {
+      token = MLX.dequantized(
+        packed,
+        scales: scales,
+        biases: weights["\(key).biases"],
+        groupSize: groupSize,
+        bits: bits,
+        mode: mode,
+        dtype: .bfloat16
+      )
+    } else {
+      token = packed
+    }
+
+    guard token.ndim > 0, token.dim(token.ndim - 1) == configuration.dim else {
+      return nil
+    }
+    return token
+  }
